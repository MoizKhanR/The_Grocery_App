<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:The_Grocery_App"
             xmlns:ctrls="clr-namespace:The_Grocery_App.Controls"
             x:Class="The_Grocery_App.ShoppingListPage"
             x:Name="this"
             Title="{Binding Page_Name}"
             BackgroundColor="#F5F5E8">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="Lists" Clicked="OnListsClicked" />
        <ToolbarItem Text="?" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>-->

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="lists.png" Clicked="OnListsClicked" />
        <ToolbarItem IconImageSource="help.png" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>


    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto"
          ColumnDefinitions="*, Auto"
          RowSpacing="10"
          ColumnSpacing="10"
          Padding="10">

        <!-- PRO Banner (auto-hides when Is_Premium is true) -->
        <ctrls:ProBanner Grid.Row="0"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,4" />

        <Button Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Add Something..."
                Background="{StaticResource ActionGreen}"
                Clicked="Add_Button_Clicked" />

        <CollectionView x:Name="Grocery_List_Collection_View"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding Grouped_Items_Observable}"
                        IsGrouped="True">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Category_Name}"
                           BackgroundColor="Goldenrod"
                           FontSize="18"
                           Padding="5"
                           FontAttributes="Bold"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           Command="{Binding Shopping_List_Delete_Command}"
                                           BackgroundColor="Red" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3"
                                Margin="0"
                                BackgroundColor="{Binding BackColor}"
                                Stroke="LightGray"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Is_Bought}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding UI_Name}"
                                       TextDecorations="{Binding Item_Decoration}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Label Grid.Column="2"
                                       Text="Quantity"
                                       FontSize="10"
                                       TextColor="Red"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,0,0,5" />

                                <Picker Grid.Column="2"
                                        ItemsSource="{Binding UI_Quantity}"
                                        SelectedItem="{Binding Selected_Quantity}"
                                        IsVisible="{Binding Picker_Visibility}"
                                        IsEnabled="{Binding Pickers_Enabled}"
                                        VerticalOptions="Center"
                                        Title="Select"
                                        Margin="0,5,0,0" />

                                <Label Grid.Column="3"
                                       Text="Size"
                                       FontSize="10"
                                       TextColor="Red"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,0,0,5" />

                                <Picker Grid.Column="3"
                                        ItemsSource="{Binding UI_Sizes}"
                                        SelectedIndex="{Binding Size_Index}"
                                        IsVisible="{Binding Picker_Visibility}"
                                        IsEnabled="{Binding Pickers_Enabled}"
                                        VerticalOptions="Center"
                                        Title="Select"
                                        Margin="0,5,0,0" />

                                <Label Grid.Column="4"
                                       Text="Quality"
                                       FontSize="10"
                                       TextColor="Red"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,0,0,5" />

                                <Picker Grid.Column="4"
                                        ItemsSource="{Binding UI_Qualities}"
                                        SelectedIndex="{Binding Quality_Index}"
                                        IsVisible="{Binding Picker_Visibility}"
                                        IsEnabled="{Binding Pickers_Enabled}"
                                        VerticalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Title="Select"
                                        Margin="0,5,0,0" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Ad Banner (via AdBanner ContentView XAML & Class) -->
        <ctrls:AdBanner Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2" />
    </Grid>
</ContentPage>
