<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrls="clr-namespace:The_Grocery_App.Controls"
             x:Class="The_Grocery_App.MainPage"
             BackgroundColor="#F5F5E8">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="?" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>-->

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="help.png" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, 80"
          ColumnDefinitions="*, Auto"
          RowSpacing="12"
          ColumnSpacing="10"
          Padding="14,10,14,10">

        <!-- Whole page glides in -->
        <Grid.Behaviors>
            <ctrls:FadeInBehavior Duration="320" Offset="14" />
        </Grid.Behaviors>

        <!-- PRO Banner (auto-hides when Is_Premium is true) -->
        <ctrls:ProBanner Grid.Row="0"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,2" />

        <!-- Entry + Add button -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Style="{StaticResource InputCard}">
            <Entry x:Name="List_Name_Entry"
                   Placeholder="New list or recipe name..."
                   VerticalOptions="Center" />
        </Border>

        <Button x:Name="CounterBtn"
                Grid.Row="1"
                Grid.Column="1"
                Text="Add"
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />

        <!-- Shopping Lists -->
        <CollectionView x:Name="Grocery_List_Collection_View"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding UI_Grocery_List_Names}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView BackgroundColor="Transparent">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           Style="{StaticResource DeleteSwipe}"
                                           Command="{Binding Main_Shopping_Delete_Command}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource RowCard}">
                            <Border.Triggers>
                                <!-- Section header rows ("Shopping Lists" / "Recipes") get the brand green -->
                                <DataTrigger TargetType="Border" Binding="{Binding Item_Font_Attributes}" Value="{x:Static FontAttributes.Bold}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource HeaderGreen}" />
                                    <Setter Property="Stroke" Value="{StaticResource HeaderGreen}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*, Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Main_ShoppingList_Tap_Command}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0"
                                       Text="{Binding UI_Name}"
                                       FontFamily="NunitoBold"
                                       FontSize="17"
                                       Padding="16,13"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <!-- Section header row ("Shopping Lists") -->
                                        <DataTrigger TargetType="Label" Binding="{Binding Item_Font_Attributes}" Value="{x:Static FontAttributes.Bold}">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontFamily" Value="NunitoExtraBold" />
                                            <Setter Property="Padding" Value="16,10" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="1"
                                       Text="&#x203A;"
                                       FontSize="24"
                                       TextColor="{StaticResource MutedText}"
                                       VerticalOptions="Center"
                                       Margin="0,0,16,3">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Item_Font_Attributes}" Value="{x:Static FontAttributes.Bold}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Recipes -->
        <CollectionView x:Name="Recipes_List_Collection_View"
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding UI_Recipe_List_Names}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" VerticalItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView BackgroundColor="Transparent">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           Style="{StaticResource DeleteSwipe}"
                                           Command="{Binding Main_Recipe_Delete_Command}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource RowCard}">
                            <Border.Triggers>
                                <!-- Section header rows ("Shopping Lists" / "Recipes") get the brand green -->
                                <DataTrigger TargetType="Border" Binding="{Binding Item_Font_Attributes}" Value="{x:Static FontAttributes.Bold}">
                                    <Setter Property="BackgroundColor" Value="{StaticResource HeaderGreen}" />
                                    <Setter Property="Stroke" Value="{StaticResource HeaderGreen}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*, Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Main_Recipes_Tap_Command}" />
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0"
                                       Text="{Binding UI_Name}"
                                       FontFamily="NunitoBold"
                                       FontSize="17"
                                       Padding="16,13"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <!-- Section header row ("Recipes") -->
                                        <DataTrigger TargetType="Label" Binding="{Binding Item_Font_Attributes}" Value="{x:Static FontAttributes.Bold}">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontFamily" Value="NunitoExtraBold" />
                                            <Setter Property="Padding" Value="16,10" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="1"
                                       Text="&#x203A;"
                                       FontSize="24"
                                       TextColor="{StaticResource MutedText}"
                                       VerticalOptions="Center"
                                       Margin="0,0,16,3">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Item_Font_Attributes}" Value="{x:Static FontAttributes.Bold}">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Ad Banner (via AdBanner ContentView XAML & Class) -->
        <ctrls:AdBanner Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="2" />

    </Grid>

</ContentPage>
