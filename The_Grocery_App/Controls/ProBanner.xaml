<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="The_Grocery_App.Controls.ProBanner">

    <Border x:Name="Banner_Border"
            StrokeShape="RoundRectangle 14"
            StrokeThickness="1"
            Stroke="#C9971C"
            Padding="0"
            Margin="0">

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE08A" Offset="0.0" />
                <GradientStop Color="#F6BE2C" Offset="0.55" />
                <GradientStop Color="#DE9E12" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Border.Shadow>
            <Shadow Brush="#8A6100" Opacity="0.28" Radius="10" Offset="0,3" />
        </Border.Shadow>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="On_Banner_Tapped" />
        </Border.GestureRecognizers>

        <Grid>
            <Grid ColumnDefinitions="Auto, *, Auto"
                  ColumnSpacing="10"
                  Padding="14,10">
                <Label x:Name="Crown_Label"
                       Grid.Column="0"
                       Text="👑"
                       FontSize="20"
                       VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="0"
                                     VerticalOptions="Center">
                    <Label Text="Unlock PRO"
                           TextColor="#3B2A05"
                           FontFamily="NunitoExtraBold"
                           FontSize="15" />
                    <Label Text="Remove Ads &amp; Unlimited Recipes"
                           TextColor="#5C4207"
                           FontFamily="NunitoSemiBold"
                           FontSize="12" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="#3B2A05"
                        Padding="10,4"
                        VerticalOptions="Center">
                    <Label Text="GO PRO"
                           TextColor="#FFE08A"
                           FontFamily="NunitoExtraBold"
                           FontSize="11"
                           CharacterSpacing="0.8" />
                </Border>
            </Grid>

            <!-- One soft shine sweep across the banner when it appears -->
            <BoxView x:Name="Shine"
                     InputTransparent="True"
                     WidthRequest="70"
                     HorizontalOptions="Start"
                     Rotation="18"
                     Margin="0,-20"
                     Opacity="0">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0.0" />
                        <GradientStop Color="#99FFFFFF" Offset="0.5" />
                        <GradientStop Color="#00FFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
        </Grid>
    </Border>
</ContentView>
