<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrls="clr-namespace:The_Grocery_App.Controls"
             x:Class="The_Grocery_App.MainPage"
             BackgroundColor="#F5F5E8">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="?" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>-->

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="help.png" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, 80"
          ColumnDefinitions="*, Auto"
          RowSpacing="10"
          ColumnSpacing="10"
          Padding="10">

        <!-- PRO Banner (auto-hides when Is_Premium is true) -->
        <ctrls:ProBanner Grid.Row="0"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,4" />

        <!-- Entry + Add button -->
        <Entry x:Name="List_Name_Entry"
               Grid.Row="1"
               Grid.Column="0"
               Placeholder="ENTER:" />

        <Button x:Name="CounterBtn"
                Grid.Row="1"
                Grid.Column="1"
                Text="Add"
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />

        <!-- Shopping Lists -->
        <CollectionView x:Name="Grocery_List_Collection_View"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding UI_Grocery_List_Names}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           Command="{Binding Main_Shopping_Delete_Command}"
                                           BackgroundColor="Red" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3"
                                Margin="0"
                                BackgroundColor="{Binding BackColor}"
                                Stroke="LightGray"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding UI_Name}"
                                       FontSize="18"
                                       FontAttributes="{Binding Item_Font_Attributes}"
                                       VerticalOptions="End">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Main_ShoppingList_Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Recipes -->
        <CollectionView x:Name="Recipes_List_Collection_View"
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding UI_Recipe_List_Names}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           Command="{Binding Main_Recipe_Delete_Command}"
                                           BackgroundColor="Red" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3"
                                Margin="0"
                                BackgroundColor="{Binding BackColor}"
                                Stroke="LightGray"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding UI_Name}"
                                       FontSize="18"
                                       FontAttributes="{Binding Item_Font_Attributes}"
                                       VerticalOptions="End">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Main_Recipes_Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Ad Banner (via AdBanner ContentView XAML & Class) -->
        <ctrls:AdBanner Grid.Row="5"
                        Grid.Column="0"
                        Grid.ColumnSpan="2" />

    </Grid>

</ContentPage>