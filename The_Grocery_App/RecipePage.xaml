<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="The_Grocery_App.RecipePage"
             Title="RecipePage"
             BackgroundColor="#F5F5E8"
             x:Name="this">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Lists" Clicked="OnListsClicked"/>
    </ContentPage.ToolbarItems>

        <Grid   RowDefinitions="Auto, Auto, Auto, *"
                ColumnDefinitions="*, *, *, Auto"
                RowSpacing="10"
                ColumnSpacing="10"
                Padding="10"> 


        <Button Text="Add Items Manually" 
                Grid.Row="0"
                Grid.Column="0"
                Grid.RowSpan="1"
                Grid.ColumnSpan="4"
                Background="#00FF52"
                Clicked="Add_Button_Clicked"/>

        <Button Text="Generate Items List" 
                Grid.Row="1"
                Grid.Column="0"
                Grid.RowSpan="1"
                Grid.ColumnSpan="4"
                Background="#00FFEB"/>

        <Entry  x:Name="AI_Prompt_Entry"
                Placeholder="Describe the recipe you want to create..." 
                Grid.Column="0"
                Grid.Row="2"
                Grid.ColumnSpan="3"/>

        <Button Grid.Row="2"
                Grid.Column="3"
                x:Name="Generate_Recipe_GO_Button"
                Text="Go" 
                SemanticProperties.Hint="Initialize recipe generation"
                HorizontalOptions="Fill"
                Grid.ColumnSpan="1"
                Clicked="OnGoButtonClicked"/>


        <CollectionView Grid.Row="3" 
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        x:Name="Grocery_List_Collection_View"
                        ItemsSource="{Binding Grouped_Items_Observable}"
                        IsGrouped="True">   
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Category_Name}"
                   BackgroundColor="Goldenrod"
                   FontSize="18"
                   FontAttributes="Bold"
                   Padding="5"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" 
                           Command="{Binding Recipe_Delete_Command}"
                           BackgroundColor="Red"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3" Margin="0"
                            BackgroundColor="{Binding BackColor}"
                            Stroke="LightGray"
                            StrokeThickness="1">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                <CheckBox  IsChecked="{Binding Is_Bought}"
                                   VerticalOptions="Center"
                                   Grid.Column ="0"/>
                                <Label Text="{Binding UI_Name}"
                               TextDecorations="{Binding Item_Decoration}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Grid.Column="1">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <Label  Text="Quantity" 
                                FontSize="10" 
                                TextColor="Red"
                                Grid.Column="2" 
                                HorizontalTextAlignment="Center"
                                Margin="0, 0, 0, 5"/>

                                <Picker ItemsSource="{Binding UI_Quantity}"
                                SelectedItem="{Binding Selected_Quantity}"
                                IsVisible="{Binding Picker_Visibility}"
                                IsEnabled="{Binding Pickers_Enabled}"
                                VerticalOptions="Center"
                                Grid.Column="2"
                                Title="Select"
                                Margin="0, 5, 0, 0"/>

                                <Label  Text="Size" 
                                FontSize="10" 
                                TextColor="Red"
                                Grid.Column="3"
                                HorizontalTextAlignment="Center"
                                Margin="0, 0, 0, 5"/>

                                <Picker ItemsSource="{Binding UI_Sizes}"
                                SelectedItem="{Binding Selected_Size}"
                                IsVisible="{Binding Picker_Visibility}"
                                IsEnabled="{Binding Pickers_Enabled}"
                                VerticalOptions="Center"
                                Grid.Column="3"
                                Title="Select"
                                Margin="0, 5, 0, 0"/>

                                <Label  Text="Quality" 
                                FontSize="10" 
                                TextColor="Red"
                                Grid.Column="4"
                                HorizontalTextAlignment="Center"
                                Margin="0, 0, 0, 5"/>

                                <Picker ItemsSource="{Binding UI_Qualities}"
                                SelectedItem="{Binding Selected_Quality}"
                                IsVisible="{Binding Picker_Visibility}"
                                IsEnabled="{Binding Pickers_Enabled}"
                                VerticalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Grid.Column="4"
                                Title="Select"
                                Margin="0, 5, 0, 0"/>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--- ItemsSource="{Binding Item_Size_Mediator, Source={x:Reference this}}" -->
    </Grid>
</ContentPage>