<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="The_Grocery_App.AddItemPage"
             Title="Add Items"
             BackgroundColor="#F5F5E8">

    <Grid RowDefinitions="Auto, Auto, Auto, *"
          ColumnDefinitions="*, Auto"
          RowSpacing="10"
          ColumnSpacing="10"
          Padding="10">

        <!--<Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />-->

        <SearchBar Grid.Row="0" Grid.Column="0"
                   Text="Search Items..."
                   Focused="SearchBarEngine"
                   x:Name="Items_Search_Bar"
                   TextChanged="SearchBar_TextChanged"/>

        <CollectionView Grid.Row="1" Grid.Column="0"                   
                x:Name="Added_Items_Collection_View"
                ItemsSource="{Binding Searched_Results}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!--<Label Text="{Binding .}" />-->
                    <Border    Padding="3" Margin="0"
                               BackgroundColor="{Binding BackColor}"
                               Stroke="LightGray"
                               StrokeThickness="1">
                        <Grid  ColumnDefinitions="*, Auto, Auto">
                            <Label  Text="{Binding UI_Name}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    VerticalOptions="End"
                                    Grid.Column="0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddItem_Tap_Command}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>