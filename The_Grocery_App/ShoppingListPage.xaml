<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:The_Grocery_App"
             xmlns:ctrls="clr-namespace:The_Grocery_App.Controls"
             x:Class="The_Grocery_App.ShoppingListPage"
             x:Name="this"
             Title="{Binding Page_Name}"
             BackgroundColor="#F5F5E8">

    <!--<ContentPage.ToolbarItems>
        <ToolbarItem Text="Lists" Clicked="OnListsClicked" />
        <ToolbarItem Text="?" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>-->

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="lists.png" Clicked="OnListsClicked" />
        <ToolbarItem IconImageSource="help.png" Clicked="OnHelpClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto, Auto"
          ColumnDefinitions="*, Auto"
          RowSpacing="10"
          ColumnSpacing="10"
          Padding="14,10,14,10">

        <!-- Whole page glides in -->
        <Grid.Behaviors>
            <ctrls:FadeInBehavior Duration="300" Offset="12" />
        </Grid.Behaviors>

        <!-- PRO Banner (auto-hides when Is_Premium is true) -->
        <ctrls:ProBanner Grid.Row="0"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,2" />

        <Button Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Add Something..."
                Background="{StaticResource ActionGreen}"
                Clicked="Add_Button_Clicked" />

        <CollectionView x:Name="Grocery_List_Collection_View"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding Grouped_Items_Observable}"
                        IsGrouped="True">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Grid Padding="0,14,0,2">
                        <Border Style="{StaticResource CategoryPill}">
                            <Label Text="{Binding Category_Name}"
                                   Style="{StaticResource CategoryText}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView BackgroundColor="Transparent">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete"
                                           Style="{StaticResource DeleteSwipe}"
                                           Command="{Binding Shopping_List_Delete_Command}" />
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Style="{StaticResource RowCard}"
                                Margin="0,8,0,0"
                                Padding="4,6,8,6">
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto"
                                  ColumnSpacing="6">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Is_Bought}"
                                          VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding UI_Name}"
                                       TextDecorations="{Binding Item_Decoration}"
                                       FontFamily="NunitoBold"
                                       FontSize="16"
                                       LineBreakMode="WordWrap"
                                       VerticalOptions="Center">
                                    <Label.Triggers>
                                        <!-- Bought: fade the name a little (strikethrough already comes from Item_Decoration) -->
                                        <DataTrigger TargetType="Label" Binding="{Binding Is_Bought}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource MutedText}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <!-- Quantity -->
                                <Border Grid.Column="2" Style="{StaticResource Chip}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Is_Bought}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="Quantity" Style="{StaticResource ChipCaption}" />
                                        <Picker Style="{StaticResource ChipPicker}"
                                                ItemsSource="{Binding UI_Quantity}"
                                                SelectedItem="{Binding Selected_Quantity}"
                                                IsVisible="{Binding Picker_Visibility}"
                                                IsEnabled="{Binding Pickers_Enabled}"
                                                Title="Select" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Size -->
                                <Border Grid.Column="3" Style="{StaticResource Chip}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Is_Bought}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="Size" Style="{StaticResource ChipCaption}" />
                                        <Picker Style="{StaticResource ChipPicker}"
                                                ItemsSource="{Binding UI_Sizes}"
                                                SelectedIndex="{Binding Size_Index}"
                                                IsVisible="{Binding Picker_Visibility}"
                                                IsEnabled="{Binding Pickers_Enabled}"
                                                Title="Select" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Quality -->
                                <Border Grid.Column="4" Style="{StaticResource Chip}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Is_Bought}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="0">
                                        <Label Text="Quality" Style="{StaticResource ChipCaption}" />
                                        <Picker Style="{StaticResource ChipPicker}"
                                                ItemsSource="{Binding UI_Qualities}"
                                                SelectedIndex="{Binding Quality_Index}"
                                                IsVisible="{Binding Picker_Visibility}"
                                                IsEnabled="{Binding Pickers_Enabled}"
                                                Title="Select" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Ad Banner (via AdBanner ContentView XAML & Class) -->
        <ctrls:AdBanner Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2" />
    </Grid>
</ContentPage>
