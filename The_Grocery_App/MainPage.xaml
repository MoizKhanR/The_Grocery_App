<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="The_Grocery_App.MainPage"
             BackgroundColor="#F5F5E8"
             xmlns:ctrls="clr-namespace:The_Grocery_App.Controls">



    <!--<ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">-->

            <Grid    RowDefinitions="Auto, Auto, Auto, *, 80"
                     ColumnDefinitions="*, Auto"
                     RowSpacing="10"
                     ColumnSpacing="10"
                     Padding="10">

           <Entry    x:Name="List_Name_Entry"
                     Placeholder="ENTER:" 
                     Grid.Row="0"/>


           <Button  Grid.Row="0"
                    Grid.Column="1"
                    x:Name="CounterBtn"
                    Text="Add" 
                    SemanticProperties.Hint="Counts the number of times you click"
                    Clicked="OnCounterClicked"
                    HorizontalOptions="Fill" />
             

        <CollectionView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"                  
                            x:Name="Grocery_List_Collection_View"
                            ItemsSource="{Binding UI_Grocery_List_Names}">
                    <CollectionView.ItemsLayout>
                            <GridItemsLayout Span="1" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" 
                                           Command="{Binding Main_Shopping_Delete_Command}"
                                           BackgroundColor="Red"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3" Margin="0"
                            BackgroundColor="{Binding BackColor}"
                            Stroke="LightGray"
                            StrokeThickness="1">    
                        <Grid ColumnDefinitions="*, Auto, Auto">
                                <Label  Text="{Binding UI_Name}"
                                FontSize="18"
                                FontAttributes="Bold"
                                VerticalOptions="End"
                                Grid.Column="0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Main_ShoppingList_Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>

        <CollectionView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"                   
                            x:Name="Recipes_List_Collection_View"
                            ItemsSource="{Binding UI_Recipe_List_Names}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" 
                                Command="{Binding Main_Recipe_Delete_Command}"
                                BackgroundColor="Red"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3" Margin="0"
                         BackgroundColor="{Binding BackColor}"
                         Stroke="LightGray"
                         StrokeThickness="1">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <Label  Text="{Binding UI_Name}"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        VerticalOptions="End"
                                        Grid.Column="0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Main_Recipes_Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>


                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Ad Banner (via AdBanner ContentView XAML & Class) -->
        <ctrls:AdBanner Grid.Row="4"
                Grid.ColumnSpan="4"/>

    </Grid>
        <!--</VerticalStackLayout>
    </ScrollView>-->



</ContentPage>
