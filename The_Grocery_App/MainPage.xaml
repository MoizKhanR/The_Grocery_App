<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="The_Grocery_App.MainPage"
             BackgroundColor="#F5F5E8">

    <!--<ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">-->

            <Grid RowDefinitions="Auto, Auto, Auto, *"
                  ColumnDefinitions="*, Auto"
                  RowSpacing="10"
                  ColumnSpacing="10"
                  Padding="10">
               

             <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    x:Name="CounterBtn"
                    Text="Add" 
                    SemanticProperties.Hint="Counts the number of times you click"
                    Clicked="OnCounterClicked"
                    HorizontalOptions="Fill" />

            <Entry  x:Name="Shopping_List_Name_Entry"
                    Placeholder="ENTER:" 
                    Grid.Row="0"/>

            <!--<CollectionView Grid.Row="2" Grid.Column="0">
                <CollectionView.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>JANABE</x:String>
                        <x:String>AALOO</x:String>
                        <x:String>LET</x:String>
                        <x:String>US</x:String>
                        <x:String>DO</x:String>
                        <x:String>THIS</x:String>
                        <x:String>THANG</x:String>
                    </x:Array>
                </CollectionView.ItemsSource>
            </CollectionView>-->


            <CollectionView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"                  
                            x:Name="Grocery_List_Collection_View"
                            ItemsSource="{Binding UI_Grocery_List_Names}">
                    <CollectionView.ItemsLayout>
                            <GridItemsLayout Span="1" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" 
                                           Command="{Binding Delete_Command}"
                                           BackgroundColor="Red"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3" Margin="0"
                            BackgroundColor="{Binding BackColor}"
                            Stroke="LightGray"
                            StrokeThickness="1">    
                            <Grid ColumnDefinitions="*, Auto, Auto">
                            <Label  Text="{Binding UI_Name}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    VerticalOptions="End"
                                    Grid.Column="0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Main_Tap_Command}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Picker ItemsSource="{Binding UI_Sizes}"
                                    SelectedItem="{Binding Selected_Size}"
                                    IsVisible = "{Binding Picker_Visibility}"
                                    VerticalOptions="Center"
                                    Grid.Column="1" />
                            <Picker ItemsSource="{Binding UI_Quantities}"
                                    SelectedItem="{Binding Selected_Quantity}"
                                    IsVisible = "{Binding Picker_Visibility}"
                                    VerticalOptions="Center"
                                    Grid.Column="2" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>

        <CollectionView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"                   
                            x:Name="Recipes_List_Collection_View"
                            ItemsSource="{Binding UI_Recipe_List_Names}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!--<Label Text="{Binding .}" />-->
                    <Border Padding="3" Margin="0"
                        BackgroundColor="{Binding BackColor}"
                        Stroke="LightGray"
                        StrokeThickness="1">
                        <Label Text="{Binding UI_Name}"
                        FontSize="18"
                        FontAttributes="Bold"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!--<CollectionView Grid.Row="1" Grid.ColumnSpan="2" 
                ItemsSource="{Binding Items}"></CollectionView>-->

    </Grid>
        <!--</VerticalStackLayout>
    </ScrollView>-->

</ContentPage>
