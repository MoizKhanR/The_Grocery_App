<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="The_Grocery_App.ShoppingListPage"
             BackgroundColor="#F5F5E8">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Lists" Clicked="OnListsClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *, Auto, Auto"
          ColumnDefinitions="*, Auto"
          RowSpacing="10"
          ColumnSpacing="10"
          Padding="10">


        <Button Text="Add Something..."
                Clicked="OnSearchBarFocused" Background="#00FF52"/>

        <CollectionView Grid.Row="1" Grid.Column="0"                   
                x:Name="Grocery_List_Collection_View"
                ItemsSource="{Binding Grouped_Items_Observable}"
                IsGrouped="True">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Category_Name}"
                   BackgroundColor="Goldenrod"
                   FontSize="18"
                   FontAttributes="Bold"
                   Padding="5"/>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" 
                                   Command="{Binding Delete_Command}"
                                   BackgroundColor="Red"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <Border Padding="3" Margin="0"
                    BackgroundColor="{Binding BackColor}"
                    Stroke="LightGray"
                    StrokeThickness="1">
                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <Label Text="{Binding UI_Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="End"
                               Grid.Column="0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Tap_Command}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Picker ItemsSource="{Binding UI_Sizes}"
                                SelectedItem="{Binding Selected_Size}"
                                IsVisible="{Binding Picker_Visibility}"
                                VerticalOptions="Center"
                                Grid.Column="1" />
                                <Picker ItemsSource="{Binding UI_Quantities}"
                                SelectedItem="{Binding Selected_Quantity}"
                                IsVisible="{Binding Picker_Visibility}"
                                VerticalOptions="Center"
                                Grid.Column="2" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>
</ContentPage>