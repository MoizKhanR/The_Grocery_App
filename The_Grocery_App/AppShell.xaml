<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="The_Grocery_App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:The_Grocery_App"
    Title="The_Grocery_App">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <Shell.Resources>
        <Style TargetType="Shell" ApplyToDerivedTypes="True">
            <Setter Property="Shell.ForegroundColor" Value="Black"/>
            <!-- Cream bar with dark title on both platforms (Android otherwise falls back to MAUI's slate default) -->
            <Setter Property="Shell.BackgroundColor" Value="#F5F5E8"/>
            <Setter Property="Shell.TitleColor" Value="#1E2A20"/>
            <Setter Property="Shell.NavBarHasShadow" Value="False"/>
        </Style>
    </Shell.Resources>



</Shell>
