<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrls="clr-namespace:The_Grocery_App.Controls"
             x:Class="The_Grocery_App.AddItemPage"
             Title="Add Items"
             BackgroundColor="#F5F5E8">

    <Grid RowDefinitions="Auto, Auto, Auto, *"
          ColumnDefinitions="*, Auto"
          RowSpacing="10"
          ColumnSpacing="10"
          Padding="10">

        <!-- PRO Banner (auto-hides when Is_Premium is true) -->
        <ctrls:ProBanner Grid.Row="0"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,0,0,4" />

        <SearchBar x:Name="Items_Search_Bar"
                   Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Text="Search Items..."
                   Focused="SearchBarEngine"
                   TextChanged="SearchBar_TextChanged"
                   SearchButtonPressed="OnSearchBarSubmitted" />

        <CollectionView x:Name="Added_Items_Collection_View"
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding Searched_Results}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Span="1" Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="3"
                            Margin="0"
                            BackgroundColor="{Binding BackColor}"
                            Stroke="LightGray"
                            StrokeThickness="1">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding UI_Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   VerticalOptions="End">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddItem_Tap_Command}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>