<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="The_Grocery_App.Controls.ProBanner">

    <Border x:Name="Banner_Border"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1"
            Stroke="#B8860B"
            Padding="12,8"
            Margin="0">

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FFD86E" Offset="0.0" />
                <GradientStop Color="#F4B400" Offset="0.5" />
                <GradientStop Color="#D49000" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.35" Radius="6" Offset="0,2" />
        </Border.Shadow>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="On_Banner_Tapped" />
        </Border.GestureRecognizers>

        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
            <Label Grid.Column="0"
                   Text="👑"
                   FontSize="18"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   Text="Unlock PRO - Remove Ads &amp; Unlimited Recipes"
                   TextColor="#3D2A00"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />

            <Label Grid.Column="2"
                   Text="→"
                   TextColor="#3D2A00"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>